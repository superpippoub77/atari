      9  5000 ????
     10  5000 ????	       00 03	   bs_mask    =	3
     11  5000 ????	       00 10	   bankswitch =	16
     12  5000 ????	       1f f6	   bankswitch_hotspot =	$1FF6
------- FILE 2600basic.h
