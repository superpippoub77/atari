   3456  fffc				  -	      if	bankswitch == 8
   3457  fffc				  -	      ORG	$2FFC
   3458  fffc				  -	      RORG	$FFFC
   3459  fffc				  -	      endif
   3460  fffc				  -	      if	bankswitch == 16
   3461  fffc				  -	      ORG	$4FFC
   3462  fffc				  -	      RORG	$FFFC
   3463  fffc				  -	      endif
   3464  fffc				  -	      if	bankswitch == 32
   3465  fffc				  -	      ORG	$8FFC
   3466  fffc				  -	      RORG	$FFFC
   3467  fffc				  -	      endif
   3468  fffc				  -	      if	bankswitch == 64
   3469  fffc				  -	      ORG	$10FF0
   3470  fffc				  -	      RORG	$1FFF0
   3471  fffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   3472  fffc				  -	      ORG	$10FF8
   3473  fffc				  -	      RORG	$1FFF8
   3474  fffc				  -	      ifconst	superchip
   3475  fffc				  -	      .byte	"E","F","S","C"
   3476  fffc				  -	      else
   3477  fffc				  -	      .byte	"E","F","E","F"
   3478  fffc				  -	      endif
   3479  fffc				  -	      ORG	$10FFC
   3480  fffc				  -	      RORG	$1FFFC
   3481  fffc				  -	      endif
   3482  fffc					      else
   3483  fffc				  -	      ifconst	ROM2k
   3484  fffc				  -	      ORG	$F7FC
   3485  fffc					      else
   3486  fffc					      ORG	$FFFC
   3487  fffc					      endif
   3488  fffc					      endif
   3489  fffc		       00 f0		      .word.w	(start & $ffff)
   3490  fffe		       00 f0		      .word.w	(start & $ffff)
