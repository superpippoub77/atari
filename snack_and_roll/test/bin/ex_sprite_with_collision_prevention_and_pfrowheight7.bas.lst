      9  10000 ????		00 01	    _P_Edge_Left =	1
     10  10000 ????
     11  10000 ????		00 4d	    _P_Edge_Bottom =	77
     12  10000 ????
     13  10000 ????		00 0c	    _P_Edge_Top =	12
