   3507  fffc				  -	      ORG	$8FFC
   3508  fffc				  -	      RORG	$FFFC
   3509  fffc				  -	      endif
   3510  fffc				  -	      if	bankswitch == 64
   3511  fffc				  -	      ORG	$10FF0
   3512  fffc				  -	      RORG	$1FFF0
   3513  fffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   3514  fffc				  -	      ORG	$10FF8
   3515  fffc				  -	      RORG	$1FFF8
   3516  fffc				  -	      ifconst	superchip
   3517  fffc				  -	      .byte	"E","F","S","C"
   3518  fffc				  -	      else
   3519  fffc				  -	      .byte	"E","F","E","F"
   3520  fffc				  -	      endif
   3521  fffc				  -	      ORG	$10FFC
   3522  fffc				  -	      RORG	$1FFFC
   3523  fffc				  -	      endif
   3524  fffc					      else
   3525  fffc				  -	      ifconst	ROM2k
   3526  fffc				  -	      ORG	$F7FC
   3527  fffc					      else
   3528  fffc					      ORG	$FFFC
   3529  fffc					      endif
   3530  fffc					      endif
   3531  fffc		       00 f0		      .word.w	(start & $ffff)
   3532  fffe		       00 f0		      .word.w	(start & $ffff)
