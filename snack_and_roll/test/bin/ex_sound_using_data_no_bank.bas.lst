     23  10000 ????		00 e6	    _Ch0_Counter =	s
     24  10000 ????
     25  10000 ????		00 e5	    _Ch0_Duration =	r
     26  10000 ????
     27  10000 ????		00 e4	    _Ch0_Sound =	q
