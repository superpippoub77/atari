   9732  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9733  2fd7					      else
   9734  2fd7		       a9 f2		      lda	#>(start-1)
   9735  2fd9					      endif
   9736  2fd9		       48		      pha
