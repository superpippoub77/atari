   9816  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   9817  2fe3
   9818  2fe3		       2a		      rol
   9819  2fe4		       2a		      rol
   9820  2fe5		       2a		      rol
   9821  2fe6		       2a		      rol
   9822  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   9823  2fe9		       aa		      tax
   9824  2fea		       e8		      inx
   9825  2feb				  -	      else
   9826  2feb				  -	      lda	4,x	; get high byte of return address
   9827  2feb				  -	      tay
