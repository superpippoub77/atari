   9786  2fd4							; every bank has this stuff at the same place
   9787  2fd4							; this code can switch to/from any bank at any entry point
   9788  2fd4							; and can preserve register values
   9789  2fd4							; note: lines not starting with a space are not placed in all banks
   9790  2fd4							;
   9791  2fd4							; line below tells the compiler how long this is - do not remove
   9792  2fd4							;size=32
   9793  2fd4
   9794  2fd4				   begin_bscode
   9795  2fd4		       a2 ff		      ldx	#$ff
   9796  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9797  2fd6				  -	      stx	FASTFETCH
   9798  2fd6					      endif
   9799  2fd6		       9a		      txs
   9800  2fd7				  -	      if	bankswitch == 64
   9801  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9802  2fd7					      else
   9803  2fd7		       a9 f2		      lda	#>(start-1)
   9804  2fd9					      endif
   9805  2fd9		       48		      pha
   9806  2fda		       a9 51		      lda	#<(start-1)
   9807  2fdc		       48		      pha
   9808  2fdd
