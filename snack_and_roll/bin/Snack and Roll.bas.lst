   9488  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   9489  2fe3
   9490  2fe3		       2a		      rol
   9491  2fe4		       2a		      rol
   9492  2fe5		       2a		      rol
   9493  2fe6		       2a		      rol
   9494  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   9495  2fe9		       aa		      tax
   9496  2fea		       e8		      inx
   9497  2feb				  -	      else
   9498  2feb				  -	      lda	4,x	; get high byte of return address
   9499  2feb				  -	      tay
