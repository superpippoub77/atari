  11053  2fd4							; every bank has this stuff at the same place
  11054  2fd4							; this code can switch to/from any bank at any entry point
  11055  2fd4							; and can preserve register values
  11056  2fd4							; note: lines not starting with a space are not placed in all banks
  11057  2fd4							;
  11058  2fd4							; line below tells the compiler how long this is - do not remove
  11059  2fd4							;size=32
  11060  2fd4
  11061  2fd4				   begin_bscode
  11062  2fd4		       a2 ff		      ldx	#$ff
  11063  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
  11064  2fd6				  -	      stx	FASTFETCH
  11065  2fd6					      endif
  11066  2fd6		       9a		      txs
  11067  2fd7				  -	      if	bankswitch == 64
  11068  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
  11069  2fd7					      else
  11070  2fd7		       a9 f2		      lda	#>(start-1)
  11071  2fd9					      endif
  11072  2fd9		       48		      pha
  11073  2fda		       a9 51		      lda	#<(start-1)
  11074  2fdc		       48		      pha
  11075  2fdd
  11076  2fdd				   BS_return
  11077  2fdd		       48		      pha
  11078  2fde		       8a		      txa
  11079  2fdf		       48		      pha
  11080  2fe0		       ba		      tsx
  11081  2fe1
  11082  2fe1					      if	bankswitch != 64
  11083  2fe1		       b5 04		      lda	4,x	; get high byte of return address
  11084  2fe3
  11085  2fe3		       2a		      rol
  11086  2fe4		       2a		      rol
  11087  2fe5		       2a		      rol
  11088  2fe6		       2a		      rol
  11089  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
  11090  2fe9		       aa		      tax
  11091  2fea		       e8		      inx
  11092  2feb				  -	      else
  11093  2feb				  -	      lda	4,x	; get high byte of return address
  11094  2feb				  -	      tay
  11095  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
  11096  2feb				  -	      sta	4,x
  11097  2feb				  -	      tya
  11098  2feb				  -	      lsr
  11099  2feb				  -	      lsr
  11100  2feb				  -	      lsr
  11101  2feb				  -	      lsr
  11102  2feb				  -	      tax
  11103  2feb				  -	      inx
  11104  2feb					      endif
  11105  2feb
  11106  2feb				   BS_jsr
  11107  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
  11108  2fee		       68		      pla
  11109  2fef		       aa		      tax
  11110  2ff0		       68		      pla
  11111  2ff1		       60		      rts
  11112  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
  11113  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
  11114  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
  11115  2ff2					      endif
