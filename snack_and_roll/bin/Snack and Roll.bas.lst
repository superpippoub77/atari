   6782  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   6783  2fee		       68		      pla
   6784  2fef		       aa		      tax
   6785  2ff0		       68		      pla
   6786  2ff1		       60		      rts
