  10762  2ff1		       60		      rts
  10763  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
  10764  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
  10765  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
  10766  2ff2					      endif
  10767  2ff2							; Provided under the CC0 license. See the included LICENSE.txt for details.
  10768  2ff2
  10769  2ff2					      ifconst	bankswitch
  10770  2ff2					      if	bankswitch == 8
  10771  2ffc					      ORG	$2FFC
  10772  2ffc					      RORG	$FFFC
  10773  2ffc					      endif
  10774  2ffc				  -	      if	bankswitch == 16
  10775  2ffc				  -	      ORG	$4FFC
  10776  2ffc				  -	      RORG	$FFFC
  10777  2ffc					      endif
  10778  2ffc				  -	      if	bankswitch == 32
  10779  2ffc				  -	      ORG	$8FFC
  10780  2ffc				  -	      RORG	$FFFC
  10781  2ffc					      endif
  10782  2ffc				  -	      if	bankswitch == 64
  10783  2ffc				  -	      ORG	$10FF0
  10784  2ffc				  -	      RORG	$1FFF0
  10785  2ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
  10786  2ffc				  -	      ORG	$10FF8
  10787  2ffc				  -	      RORG	$1FFF8
  10788  2ffc				  -	      ifconst	superchip
  10789  2ffc				  -	      .byte	"E","F","S","C"
  10790  2ffc				  -	      else
  10791  2ffc				  -	      .byte	"E","F","E","F"
  10792  2ffc				  -	      endif
  10793  2ffc				  -	      ORG	$10FFC
  10794  2ffc				  -	      RORG	$1FFFC
  10795  2ffc					      endif
  10796  2ffc				  -	      else
  10797  2ffc				  -	      ifconst	ROM2k
  10798  2ffc				  -	      ORG	$F7FC
  10799  2ffc				  -	      else
  10800  2ffc				  -	      ORG	$FFFC
  10801  2ffc				  -	      endif
  10802  2ffc					      endif
  10803  2ffc		       52 f2		      .word.w	(start & $ffff)
  10804  2ffe		       52 f2		      .word.w	(start & $ffff)
