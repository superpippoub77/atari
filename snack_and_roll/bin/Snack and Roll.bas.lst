   8402  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   8403  2fee		       68		      pla
   8404  2fef		       aa		      tax
   8405  2ff0		       68		      pla
   8406  2ff1		       60		      rts
