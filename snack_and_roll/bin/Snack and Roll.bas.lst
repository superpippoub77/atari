   8348  2fd4							; every bank has this stuff at the same place
   8349  2fd4							; this code can switch to/from any bank at any entry point
   8350  2fd4							; and can preserve register values
   8351  2fd4							; note: lines not starting with a space are not placed in all banks
   8352  2fd4							;
   8353  2fd4							; line below tells the compiler how long this is - do not remove
   8354  2fd4							;size=32
   8355  2fd4
   8356  2fd4				   begin_bscode
   8357  2fd4		       a2 ff		      ldx	#$ff
   8358  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   8359  2fd6				  -	      stx	FASTFETCH
   8360  2fd6					      endif
   8361  2fd6		       9a		      txs
   8362  2fd7				  -	      if	bankswitch == 64
   8363  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   8364  2fd7					      else
   8365  2fd7		       a9 f2		      lda	#>(start-1)
   8366  2fd9					      endif
   8367  2fd9		       48		      pha
   8368  2fda		       a9 51		      lda	#<(start-1)
   8369  2fdc		       48		      pha
   8370  2fdd
   8371  2fdd				   BS_return
   8372  2fdd		       48		      pha
   8373  2fde		       8a		      txa
   8374  2fdf		       48		      pha
   8375  2fe0		       ba		      tsx
   8376  2fe1
   8377  2fe1					      if	bankswitch != 64
   8378  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   8379  2fe3
   8380  2fe3		       2a		      rol
   8381  2fe4		       2a		      rol
   8382  2fe5		       2a		      rol
   8383  2fe6		       2a		      rol
   8384  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   8385  2fe9		       aa		      tax
   8386  2fea		       e8		      inx
   8387  2feb				  -	      else
   8388  2feb				  -	      lda	4,x	; get high byte of return address
   8389  2feb				  -	      tay
   8390  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   8391  2feb				  -	      sta	4,x
   8392  2feb				  -	      tya
   8393  2feb				  -	      lsr
   8394  2feb				  -	      lsr
   8395  2feb				  -	      lsr
   8396  2feb				  -	      lsr
   8397  2feb				  -	      tax
   8398  2feb				  -	      inx
   8399  2feb					      endif
