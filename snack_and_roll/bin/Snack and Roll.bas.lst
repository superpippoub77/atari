   7121  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   7122  2fe3
   7123  2fe3		       2a		      rol
   7124  2fe4		       2a		      rol
   7125  2fe5		       2a		      rol
   7126  2fe6		       2a		      rol
   7127  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   7128  2fe9		       aa		      tax
   7129  2fea		       e8		      inx
   7130  2feb				  -	      else
   7131  2feb				  -	      lda	4,x	; get high byte of return address
   7132  2feb				  -	      tay
