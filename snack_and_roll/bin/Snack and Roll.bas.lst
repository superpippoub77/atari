   9459  2fd4							; this code can switch to/from any bank at any entry point
   9460  2fd4							; and can preserve register values
   9461  2fd4							; note: lines not starting with a space are not placed in all banks
   9462  2fd4							;
   9463  2fd4							; line below tells the compiler how long this is - do not remove
   9464  2fd4							;size=32
