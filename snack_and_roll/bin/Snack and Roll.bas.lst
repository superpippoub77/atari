   9731  2fd4							; every bank has this stuff at the same place
   9732  2fd4							; this code can switch to/from any bank at any entry point
   9733  2fd4							; and can preserve register values
   9734  2fd4							; note: lines not starting with a space are not placed in all banks
   9735  2fd4							;
   9736  2fd4							; line below tells the compiler how long this is - do not remove
   9737  2fd4							;size=32
