  11013  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
  11014  2feb				  -	      sta	4,x
  11015  2feb				  -	      tya
  11016  2feb				  -	      lsr
  11017  2feb				  -	      lsr
  11018  2feb				  -	      lsr
  11019  2feb				  -	      lsr
  11020  2feb				  -	      tax
  11021  2feb				  -	      inx
  11022  2feb					      endif
  11023  2feb
  11024  2feb				   BS_jsr
  11025  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
  11026  2fee		       68		      pla
  11027  2fef		       aa		      tax
  11028  2ff0		       68		      pla
  11029  2ff1		       60		      rts
  11030  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
  11031  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
  11032  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
  11033  2ff2					      endif
