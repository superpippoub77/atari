   9625  2fd4				   begin_bscode
   9626  2fd4		       a2 ff		      ldx	#$ff
   9627  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9628  2fd6				  -	      stx	FASTFETCH
   9629  2fd6					      endif
   9630  2fd6		       9a		      txs
   9631  2fd7				  -	      if	bankswitch == 64
   9632  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9633  2fd7					      else
   9634  2fd7		       a9 f2		      lda	#>(start-1)
   9635  2fd9					      endif
   9636  2fd9		       48		      pha
   9637  2fda		       a9 51		      lda	#<(start-1)
   9638  2fdc		       48		      pha
   9639  2fdd
