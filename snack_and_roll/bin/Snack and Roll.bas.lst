   9466  2fd4				   begin_bscode
   9467  2fd4		       a2 ff		      ldx	#$ff
   9468  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9469  2fd6				  -	      stx	FASTFETCH
   9470  2fd6					      endif
   9471  2fd6		       9a		      txs
   9472  2fd7				  -	      if	bankswitch == 64
   9473  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9474  2fd7					      else
   9475  2fd7		       a9 f2		      lda	#>(start-1)
   9476  2fd9					      endif
   9477  2fd9		       48		      pha
   9478  2fda		       a9 51		      lda	#<(start-1)
   9479  2fdc		       48		      pha
