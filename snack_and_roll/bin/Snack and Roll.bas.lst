   7063  2fd4		       a2 ff		      ldx	#$ff
   7064  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   7065  2fd6				  -	      stx	FASTFETCH
   7066  2fd6					      endif
   7067  2fd6		       9a		      txs
   7068  2fd7				  -	      if	bankswitch == 64
   7069  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   7070  2fd7					      else
   7071  2fd7		       a9 f2		      lda	#>(start-1)
   7072  2fd9					      endif
   7073  2fd9		       48		      pha
   7074  2fda		       a9 51		      lda	#<(start-1)
   7075  2fdc		       48		      pha
