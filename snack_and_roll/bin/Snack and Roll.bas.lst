   7091  2fd4							; every bank has this stuff at the same place
   7092  2fd4							; this code can switch to/from any bank at any entry point
   7093  2fd4							; and can preserve register values
   7094  2fd4							; note: lines not starting with a space are not placed in all banks
   7095  2fd4							;
   7096  2fd4							; line below tells the compiler how long this is - do not remove
   7097  2fd4							;size=32
   7098  2fd4
   7099  2fd4				   begin_bscode
   7100  2fd4		       a2 ff		      ldx	#$ff
   7101  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   7102  2fd6				  -	      stx	FASTFETCH
   7103  2fd6					      endif
   7104  2fd6		       9a		      txs
   7105  2fd7				  -	      if	bankswitch == 64
   7106  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   7107  2fd7					      else
   7108  2fd7		       a9 f2		      lda	#>(start-1)
   7109  2fd9					      endif
   7110  2fd9		       48		      pha
   7111  2fda		       a9 51		      lda	#<(start-1)
   7112  2fdc		       48		      pha
   7113  2fdd
