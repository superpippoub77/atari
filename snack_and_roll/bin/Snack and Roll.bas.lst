  11033  2fd4					      endif
  11034  2fd4				  -	      if	bankswitch == 16
  11035  2fd4				  -	      ORG	$4FF4-bscode_length
  11036  2fd4				  -	      RORG	$FFF4-bscode_length
  11037  2fd4					      endif
  11038  2fd4				  -	      if	bankswitch == 32
  11039  2fd4				  -	      ORG	$8FF4-bscode_length
  11040  2fd4				  -	      RORG	$FFF4-bscode_length
  11041  2fd4					      endif
  11042  2fd4				  -	      if	bankswitch == 64
  11043  2fd4				  -	      ORG	$10FE0-bscode_length
  11044  2fd4				  -	      RORG	$1FFE0-bscode_length
  11045  2fd4					      endif
  11046  2fd4				  -	      else
  11047  2fd4				  -	      ORG	$FFFC
  11048  2fd4					      endif
  11049  2fd4					      endif
