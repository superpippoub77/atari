   7085  2fd4							; every bank has this stuff at the same place
   7086  2fd4							; this code can switch to/from any bank at any entry point
   7087  2fd4							; and can preserve register values
   7088  2fd4							; note: lines not starting with a space are not placed in all banks
   7089  2fd4							;
   7090  2fd4							; line below tells the compiler how long this is - do not remove
   7091  2fd4							;size=32
   7092  2fd4
   7093  2fd4				   begin_bscode
   7094  2fd4		       a2 ff		      ldx	#$ff
   7095  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   7096  2fd6				  -	      stx	FASTFETCH
   7097  2fd6					      endif
   7098  2fd6		       9a		      txs
   7099  2fd7				  -	      if	bankswitch == 64
   7100  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   7101  2fd7					      else
   7102  2fd7		       a9 f2		      lda	#>(start-1)
   7103  2fd9					      endif
   7104  2fd9		       48		      pha
   7105  2fda		       a9 51		      lda	#<(start-1)
   7106  2fdc		       48		      pha
   7107  2fdd
