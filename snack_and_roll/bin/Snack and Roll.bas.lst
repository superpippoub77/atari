   9739  2fd4				   begin_bscode
   9740  2fd4		       a2 ff		      ldx	#$ff
   9741  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9742  2fd6				  -	      stx	FASTFETCH
   9743  2fd6					      endif
   9744  2fd6		       9a		      txs
   9745  2fd7				  -	      if	bankswitch == 64
   9746  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9747  2fd7					      else
   9748  2fd7		       a9 f2		      lda	#>(start-1)
   9749  2fd9					      endif
   9750  2fd9		       48		      pha
   9751  2fda		       a9 51		      lda	#<(start-1)
   9752  2fdc		       48		      pha
   9753  2fdd
