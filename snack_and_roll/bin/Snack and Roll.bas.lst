   6728  2fd4							; every bank has this stuff at the same place
   6729  2fd4							; this code can switch to/from any bank at any entry point
   6730  2fd4							; and can preserve register values
   6731  2fd4							; note: lines not starting with a space are not placed in all banks
   6732  2fd4							;
   6733  2fd4							; line below tells the compiler how long this is - do not remove
   6734  2fd4							;size=32
   6735  2fd4
   6736  2fd4				   begin_bscode
   6737  2fd4		       a2 ff		      ldx	#$ff
   6738  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   6739  2fd6				  -	      stx	FASTFETCH
   6740  2fd6					      endif
   6741  2fd6		       9a		      txs
   6742  2fd7				  -	      if	bankswitch == 64
   6743  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   6744  2fd7					      else
   6745  2fd7		       a9 f2		      lda	#>(start-1)
   6746  2fd9					      endif
   6747  2fd9		       48		      pha
   6748  2fda		       a9 51		      lda	#<(start-1)
   6749  2fdc		       48		      pha
   6750  2fdd
   6751  2fdd				   BS_return
   6752  2fdd		       48		      pha
   6753  2fde		       8a		      txa
   6754  2fdf		       48		      pha
   6755  2fe0		       ba		      tsx
   6756  2fe1
   6757  2fe1					      if	bankswitch != 64
   6758  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   6759  2fe3
   6760  2fe3		       2a		      rol
   6761  2fe4		       2a		      rol
   6762  2fe5		       2a		      rol
   6763  2fe6		       2a		      rol
   6764  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   6765  2fe9		       aa		      tax
   6766  2fea		       e8		      inx
   6767  2feb				  -	      else
   6768  2feb				  -	      lda	4,x	; get high byte of return address
   6769  2feb				  -	      tay
   6770  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   6771  2feb				  -	      sta	4,x
   6772  2feb				  -	      tya
   6773  2feb				  -	      lsr
   6774  2feb				  -	      lsr
   6775  2feb				  -	      lsr
   6776  2feb				  -	      lsr
