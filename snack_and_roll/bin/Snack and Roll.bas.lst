   9570  2fd4							; every bank has this stuff at the same place
   9571  2fd4							; this code can switch to/from any bank at any entry point
   9572  2fd4							; and can preserve register values
   9573  2fd4							; note: lines not starting with a space are not placed in all banks
   9574  2fd4							;
   9575  2fd4							; line below tells the compiler how long this is - do not remove
   9576  2fd4							;size=32
   9577  2fd4
   9578  2fd4				   begin_bscode
   9579  2fd4		       a2 ff		      ldx	#$ff
   9580  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9581  2fd6				  -	      stx	FASTFETCH
   9582  2fd6					      endif
   9583  2fd6		       9a		      txs
   9584  2fd7				  -	      if	bankswitch == 64
   9585  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9586  2fd7					      else
   9587  2fd7		       a9 f2		      lda	#>(start-1)
   9588  2fd9					      endif
   9589  2fd9		       48		      pha
   9590  2fda		       a9 51		      lda	#<(start-1)
   9591  2fdc		       48		      pha
   9592  2fdd
   9593  2fdd				   BS_return
   9594  2fdd		       48		      pha
   9595  2fde		       8a		      txa
   9596  2fdf		       48		      pha
   9597  2fe0		       ba		      tsx
   9598  2fe1
   9599  2fe1					      if	bankswitch != 64
   9600  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   9601  2fe3
   9602  2fe3		       2a		      rol
   9603  2fe4		       2a		      rol
   9604  2fe5		       2a		      rol
   9605  2fe6		       2a		      rol
   9606  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   9607  2fe9		       aa		      tax
   9608  2fea		       e8		      inx
   9609  2feb				  -	      else
   9610  2feb				  -	      lda	4,x	; get high byte of return address
   9611  2feb				  -	      tay
   9612  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   9613  2feb				  -	      sta	4,x
   9614  2feb				  -	      tya
   9615  2feb				  -	      lsr
   9616  2feb				  -	      lsr
   9617  2feb				  -	      lsr
   9618  2feb				  -	      lsr
