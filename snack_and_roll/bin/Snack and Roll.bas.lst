  11035  2ff2
  11036  2ff2					      ifconst	bankswitch
  11037  2ff2					      if	bankswitch == 8
  11038  2ffc					      ORG	$2FFC
  11039  2ffc					      RORG	$FFFC
  11040  2ffc					      endif
  11041  2ffc				  -	      if	bankswitch == 16
  11042  2ffc				  -	      ORG	$4FFC
  11043  2ffc				  -	      RORG	$FFFC
  11044  2ffc					      endif
  11045  2ffc				  -	      if	bankswitch == 32
  11046  2ffc				  -	      ORG	$8FFC
  11047  2ffc				  -	      RORG	$FFFC
  11048  2ffc					      endif
  11049  2ffc				  -	      if	bankswitch == 64
  11050  2ffc				  -	      ORG	$10FF0
  11051  2ffc				  -	      RORG	$1FFF0
  11052  2ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
  11053  2ffc				  -	      ORG	$10FF8
  11054  2ffc				  -	      RORG	$1FFF8
  11055  2ffc				  -	      ifconst	superchip
  11056  2ffc				  -	      .byte	"E","F","S","C"
  11057  2ffc				  -	      else
  11058  2ffc				  -	      .byte	"E","F","E","F"
  11059  2ffc				  -	      endif
  11060  2ffc				  -	      ORG	$10FFC
  11061  2ffc				  -	      RORG	$1FFFC
  11062  2ffc					      endif
  11063  2ffc				  -	      else
  11064  2ffc				  -	      ifconst	ROM2k
  11065  2ffc				  -	      ORG	$F7FC
  11066  2ffc				  -	      else
  11067  2ffc				  -	      ORG	$FFFC
  11068  2ffc				  -	      endif
  11069  2ffc					      endif
