   7145  2fd4		       a2 ff		      ldx	#$ff
   7146  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   7147  2fd6				  -	      stx	FASTFETCH
   7148  2fd6					      endif
   7149  2fd6		       9a		      txs
   7150  2fd7				  -	      if	bankswitch == 64
   7151  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   7152  2fd7					      else
   7153  2fd7		       a9 f2		      lda	#>(start-1)
   7154  2fd9					      endif
   7155  2fd9		       48		      pha
   7156  2fda		       a9 51		      lda	#<(start-1)
   7157  2fdc		       48		      pha
