   7115  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   7116  2fe3
   7117  2fe3		       2a		      rol
   7118  2fe4		       2a		      rol
   7119  2fe5		       2a		      rol
   7120  2fe6		       2a		      rol
   7121  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   7122  2fe9		       aa		      tax
   7123  2fea		       e8		      inx
   7124  2feb				  -	      else
   7125  2feb				  -	      lda	4,x	; get high byte of return address
   7126  2feb				  -	      tay
