   9647  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   9648  2fe3
   9649  2fe3		       2a		      rol
   9650  2fe4		       2a		      rol
   9651  2fe5		       2a		      rol
   9652  2fe6		       2a		      rol
