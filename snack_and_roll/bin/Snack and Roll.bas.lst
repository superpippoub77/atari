  11120  2ffc					      ORG	$2FFC
  11121  2ffc					      RORG	$FFFC
  11122  2ffc					      endif
  11123  2ffc				  -	      if	bankswitch == 16
  11124  2ffc				  -	      ORG	$4FFC
  11125  2ffc				  -	      RORG	$FFFC
  11126  2ffc					      endif
  11127  2ffc				  -	      if	bankswitch == 32
  11128  2ffc				  -	      ORG	$8FFC
  11129  2ffc				  -	      RORG	$FFFC
  11130  2ffc					      endif
  11131  2ffc				  -	      if	bankswitch == 64
  11132  2ffc				  -	      ORG	$10FF0
  11133  2ffc				  -	      RORG	$1FFF0
