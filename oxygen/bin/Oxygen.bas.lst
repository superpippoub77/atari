   6704  2fd4							; every bank has this stuff at the same place
   6705  2fd4							; this code can switch to/from any bank at any entry point
   6706  2fd4							; and can preserve register values
   6707  2fd4							; note: lines not starting with a space are not placed in all banks
   6708  2fd4							;
   6709  2fd4							; line below tells the compiler how long this is - do not remove
   6710  2fd4							;size=32
   6711  2fd4
   6712  2fd4				   begin_bscode
   6713  2fd4		       a2 ff		      ldx	#$ff
   6714  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   6715  2fd6				  -	      stx	FASTFETCH
   6716  2fd6					      endif
   6717  2fd6		       9a		      txs
   6718  2fd7				  -	      if	bankswitch == 64
   6719  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   6720  2fd7					      else
   6721  2fd7		       a9 f2		      lda	#>(start-1)
   6722  2fd9					      endif
   6723  2fd9		       48		      pha
   6724  2fda		       a9 51		      lda	#<(start-1)
   6725  2fdc		       48		      pha
   6726  2fdd
   6727  2fdd				   BS_return
   6728  2fdd		       48		      pha
   6729  2fde		       8a		      txa
   6730  2fdf		       48		      pha
   6731  2fe0		       ba		      tsx
   6732  2fe1
   6733  2fe1					      if	bankswitch != 64
   6734  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   6735  2fe3
   6736  2fe3		       2a		      rol
   6737  2fe4		       2a		      rol
   6738  2fe5		       2a		      rol
   6739  2fe6		       2a		      rol
   6740  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   6741  2fe9		       aa		      tax
   6742  2fea		       e8		      inx
   6743  2feb				  -	      else
   6744  2feb				  -	      lda	4,x	; get high byte of return address
   6745  2feb				  -	      tay
   6746  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   6747  2feb				  -	      sta	4,x
   6748  2feb				  -	      tya
   6749  2feb				  -	      lsr
   6750  2feb				  -	      lsr
   6751  2feb				  -	      lsr
   6752  2feb				  -	      lsr
   6753  2feb				  -	      tax
   6754  2feb				  -	      inx
   6755  2feb					      endif
   6756  2feb
   6757  2feb				   BS_jsr
   6758  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   6759  2fee		       68		      pla
   6760  2fef		       aa		      tax
   6761  2ff0		       68		      pla
   6762  2ff1		       60		      rts
   6763  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   6764  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   6765  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   6766  2ff2					      endif
