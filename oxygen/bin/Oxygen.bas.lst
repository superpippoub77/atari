   6636  2fcc					      ifconst	bankswitch
   6637  2fcc					      if	bankswitch == 8
   6638  2fd4					      ORG	$2FF4-bscode_length
   6639  2fd4					      RORG	$FFF4-bscode_length
   6640  2fd4					      endif
   6641  2fd4				  -	      if	bankswitch == 16
   6642  2fd4				  -	      ORG	$4FF4-bscode_length
   6643  2fd4				  -	      RORG	$FFF4-bscode_length
   6644  2fd4					      endif
   6645  2fd4				  -	      if	bankswitch == 32
   6646  2fd4				  -	      ORG	$8FF4-bscode_length
   6647  2fd4				  -	      RORG	$FFF4-bscode_length
   6648  2fd4					      endif
   6649  2fd4				  -	      if	bankswitch == 64
   6650  2fd4				  -	      ORG	$10FE0-bscode_length
   6651  2fd4				  -	      RORG	$1FFE0-bscode_length
   6652  2fd4					      endif
   6653  2fd4				  -	      else
   6654  2fd4				  -	      ORG	$FFFC
   6655  2fd4					      endif
   6656  2fd4					      endif
   6657  2fd4					      endif
