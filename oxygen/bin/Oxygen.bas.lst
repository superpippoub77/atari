   6659  2fd4
   6660  2fd4							; every bank has this stuff at the same place
   6661  2fd4							; this code can switch to/from any bank at any entry point
   6662  2fd4							; and can preserve register values
   6663  2fd4							; note: lines not starting with a space are not placed in all banks
   6664  2fd4							;
   6665  2fd4							; line below tells the compiler how long this is - do not remove
   6666  2fd4							;size=32
   6667  2fd4
   6668  2fd4				   begin_bscode
   6669  2fd4		       a2 ff		      ldx	#$ff
   6670  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
   6671  2fd6				  -	      stx	FASTFETCH
   6672  2fd6					      endif
   6673  2fd6		       9a		      txs
   6674  2fd7				  -	      if	bankswitch == 64
   6675  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   6676  2fd7					      else
   6677  2fd7		       a9 f2		      lda	#>(start-1)
   6678  2fd9					      endif
   6679  2fd9		       48		      pha
   6680  2fda		       a9 51		      lda	#<(start-1)
   6681  2fdc		       48		      pha
   6682  2fdd
   6683  2fdd				   BS_return
   6684  2fdd		       48		      pha
   6685  2fde		       8a		      txa
   6686  2fdf		       48		      pha
   6687  2fe0		       ba		      tsx
   6688  2fe1
   6689  2fe1					      if	bankswitch != 64
   6690  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   6691  2fe3
   6692  2fe3		       2a		      rol
   6693  2fe4		       2a		      rol
   6694  2fe5		       2a		      rol
   6695  2fe6		       2a		      rol
   6696  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   6697  2fe9		       aa		      tax
   6698  2fea		       e8		      inx
   6699  2feb				  -	      else
   6700  2feb				  -	      lda	4,x	; get high byte of return address
   6701  2feb				  -	      tay
   6702  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   6703  2feb				  -	      sta	4,x
   6704  2feb				  -	      tya
   6705  2feb				  -	      lsr
   6706  2feb				  -	      lsr
   6707  2feb				  -	      lsr
   6708  2feb				  -	      lsr
   6709  2feb				  -	      tax
   6710  2feb				  -	      inx
   6711  2feb					      endif
   6712  2feb
   6713  2feb				   BS_jsr
   6714  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   6715  2fee		       68		      pla
   6716  2fef		       aa		      tax
   6717  2ff0		       68		      pla
   6718  2ff1		       60		      rts
   6719  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   6720  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   6721  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   6722  2ff2					      endif
   6723  2ff2							; Provided under the CC0 license. See the included LICENSE.txt for details.
   6724  2ff2
   6725  2ff2					      ifconst	bankswitch
   6726  2ff2					      if	bankswitch == 8
   6727  2ffc					      ORG	$2FFC
   6728  2ffc					      RORG	$FFFC
   6729  2ffc					      endif
   6730  2ffc				  -	      if	bankswitch == 16
   6731  2ffc				  -	      ORG	$4FFC
   6732  2ffc				  -	      RORG	$FFFC
   6733  2ffc					      endif
   6734  2ffc				  -	      if	bankswitch == 32
   6735  2ffc				  -	      ORG	$8FFC
   6736  2ffc				  -	      RORG	$FFFC
   6737  2ffc					      endif
   6738  2ffc				  -	      if	bankswitch == 64
   6739  2ffc				  -	      ORG	$10FF0
   6740  2ffc				  -	      RORG	$1FFF0
   6741  2ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   6742  2ffc				  -	      ORG	$10FF8
   6743  2ffc				  -	      RORG	$1FFF8
   6744  2ffc				  -	      ifconst	superchip
   6745  2ffc				  -	      .byte	"E","F","S","C"
   6746  2ffc				  -	      else
   6747  2ffc				  -	      .byte	"E","F","E","F"
   6748  2ffc				  -	      endif
   6749  2ffc				  -	      ORG	$10FFC
   6750  2ffc				  -	      RORG	$1FFFC
   6751  2ffc					      endif
   6752  2ffc				  -	      else
   6753  2ffc				  -	      ifconst	ROM2k
   6754  2ffc				  -	      ORG	$F7FC
   6755  2ffc				  -	      else
   6756  2ffc				  -	      ORG	$FFFC
   6757  2ffc				  -	      endif
