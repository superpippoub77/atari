   5666  2ff2
   5667  2ff2					      ifconst	bankswitch
   5668  2ff2					      if	bankswitch == 8
   5669  2ffc					      ORG	$2FFC
   5670  2ffc					      RORG	$FFFC
   5671  2ffc					      endif
   5672  2ffc				  -	      if	bankswitch == 16
   5673  2ffc				  -	      ORG	$4FFC
   5674  2ffc				  -	      RORG	$FFFC
   5675  2ffc					      endif
   5676  2ffc				  -	      if	bankswitch == 32
   5677  2ffc				  -	      ORG	$8FFC
   5678  2ffc				  -	      RORG	$FFFC
   5679  2ffc					      endif
   5680  2ffc				  -	      if	bankswitch == 64
   5681  2ffc				  -	      ORG	$10FF0
   5682  2ffc				  -	      RORG	$1FFF0
   5683  2ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   5684  2ffc				  -	      ORG	$10FF8
   5685  2ffc				  -	      RORG	$1FFF8
   5686  2ffc				  -	      ifconst	superchip
   5687  2ffc				  -	      .byte	"E","F","S","C"
   5688  2ffc				  -	      else
   5689  2ffc				  -	      .byte	"E","F","E","F"
   5690  2ffc				  -	      endif
   5691  2ffc				  -	      ORG	$10FFC
   5692  2ffc				  -	      RORG	$1FFFC
   5693  2ffc					      endif
   5694  2ffc				  -	      else
   5695  2ffc				  -	      ifconst	ROM2k
   5696  2ffc				  -	      ORG	$F7FC
   5697  2ffc				  -	      else
   5698  2ffc				  -	      ORG	$FFFC
   5699  2ffc				  -	      endif
   5700  2ffc					      endif
   5701  2ffc		       52 f2		      .word.w	(start & $ffff)
   5702  2ffe		       52 f2		      .word.w	(start & $ffff)
