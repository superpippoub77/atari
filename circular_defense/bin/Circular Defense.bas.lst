     21  10000 ????		00 0c	    dir8_length =	.skipL0203-dir8
     22  10000 ????
     23  10000 ????		00 0c	    near_length =	.skipL0202-near
     24  10000 ????
     25  10000 ????		00 ed	    _blocked   =	z
     26  10000 ????
     27  10000 ????		00 ec	    _sfxT      =	y
     28  10000 ????
     29  10000 ????		00 eb	    _sfxId     =	x
     30  10000 ????
     31  10000 ????		00 ea	    _interval  =	w
