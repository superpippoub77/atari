   5644  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   5645  2feb				  -	      sta	4,x
   5646  2feb				  -	      tya
   5647  2feb				  -	      lsr
   5648  2feb				  -	      lsr
   5649  2feb				  -	      lsr
   5650  2feb				  -	      lsr
   5651  2feb				  -	      tax
   5652  2feb				  -	      inx
   5653  2feb					      endif
   5654  2feb
   5655  2feb				   BS_jsr
   5656  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   5657  2fee		       68		      pla
   5658  2fef		       aa		      tax
   5659  2ff0		       68		      pla
   5660  2ff1		       60		      rts
   5661  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   5662  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   5663  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   5664  2ff2					      endif
