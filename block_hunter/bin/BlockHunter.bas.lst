   7662  2ff2					      ifconst	bankswitch
   7663  2ff2					      if	bankswitch == 8
   7664  2ffc					      ORG	$2FFC
   7665  2ffc					      RORG	$FFFC
   7666  2ffc					      endif
   7667  2ffc				  -	      if	bankswitch == 16
   7668  2ffc				  -	      ORG	$4FFC
   7669  2ffc				  -	      RORG	$FFFC
   7670  2ffc					      endif
   7671  2ffc				  -	      if	bankswitch == 32
