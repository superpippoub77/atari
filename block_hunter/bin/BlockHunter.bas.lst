   7677  2ffc				  -	      RORG	$1FFF0
   7678  2ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   7679  2ffc				  -	      ORG	$10FF8
   7680  2ffc				  -	      RORG	$1FFF8
