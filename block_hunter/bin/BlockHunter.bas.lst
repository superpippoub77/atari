   7685  2ffc				  -	      endif
   7686  2ffc				  -	      ORG	$10FFC
   7687  2ffc				  -	      RORG	$1FFFC
   7688  2ffc					      endif
   7689  2ffc				  -	      else
   7690  2ffc				  -	      ifconst	ROM2k
   7691  2ffc				  -	      ORG	$F7FC
