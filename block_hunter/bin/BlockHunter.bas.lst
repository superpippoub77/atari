   7628  2fe3
   7629  2fe3		       2a		      rol
   7630  2fe4		       2a		      rol
   7631  2fe5		       2a		      rol
   7632  2fe6		       2a		      rol
   7633  2fe7		       29 01		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   7634  2fe9		       aa		      tax
   7635  2fea		       e8		      inx
   7636  2feb				  -	      else
   7637  2feb				  -	      lda	4,x	; get high byte of return address
   7638  2feb				  -	      tay
   7639  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   7640  2feb				  -	      sta	4,x
   7641  2feb				  -	      tya
   7642  2feb				  -	      lsr
   7643  2feb				  -	      lsr
   7644  2feb				  -	      lsr
   7645  2feb				  -	      lsr
   7646  2feb				  -	      tax
   7647  2feb				  -	      inx
   7648  2feb					      endif
   7649  2feb
   7650  2feb				   BS_jsr
   7651  2feb		       bd f7 1f 	      lda	bankswitch_hotspot-1,x
   7652  2fee		       68		      pla
   7653  2fef		       aa		      tax
   7654  2ff0		       68		      pla
   7655  2ff1		       60		      rts
   7656  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   7657  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   7658  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
